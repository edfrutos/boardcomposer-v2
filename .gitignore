.venv/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
*.egg-info/
build/

# graphify: local machine-specific state and extraction cache
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json

# Claude Code: personal, machine-specific permissions
.claude/settings.local.json

# Directorios de configuración de asistentes de código: herramienta personal
# de quien desarrolla, no fuente del proyecto. Un instalador de skills externo
# vuelca el mismo paquete (`ui-ux-pro-max`, con sus scripts de Python) en el
# directorio de cada IDE a la vez — 14 copias que además rompían `make check`,
# porque `ruff check .` las analizaba (196 errores en código que no es nuestro).
# Excepciones, esas sí versionadas: `.claude/launch.json` y `.github/`.
.agent/
.claude/*
!.claude/launch.json
.codebuddy/
.codex/
.continue/
.cursor/
.gemini/
.github/prompts/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.windsurf/

# macOS: fichero de icono personalizado de carpeta (su nombre acaba en CR).
Icon?

# Flake8: personal editor config, not the project's linter (ruff)
.flake8

# Codegraph: local machine-specific state and extraction cache
.codegraph/

# pyside6-deploy build output (IDE-0011): generated .app bundle and Nuitka's
# intermediate build directory, never committed.
studio/dist/
studio/deployment/

# BoardComposer Studio project files: user data, not source code.
*.bcstudio.json

# CSVs the user drops in studio/ to test import (retales, catálogo de
# materiales, etc.) — personal data, not sample/source data (that lives
# in data/samples/).
studio/*.csv

# Capturas de pantalla sueltas (secrets de GitHub, Actions, suscripción…):
# material de trabajo personal, no assets del proyecto. El repo no versiona
# ningún .png a día de hoy.
*.png

# Carpeta de trabajo personal con datos de pruebas (CSVs, proyectos .bcstudio,
# notas): no es fuente del proyecto.
__.__V2/
